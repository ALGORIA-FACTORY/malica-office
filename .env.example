# Copiez ce fichier en .env et renseignez les valeurs.
#
# .env n'est jamais suivi par git — c'est la règle du .gitignore, et le dépôt
# précédent l'avait apprise à ses dépens : il suivait .env, et les clés n'y
# étaient qu'à un « git add -A » de la publication.
#
# Ce fichier ne porte que des NOMS de variables. Jamais une valeur.

# ---------------------------------------------------------------------------
# L'API — PostgreSQL, sessions
#
# DATABASE_URL emprunte le rôle `regalica_api` : il se connecte, il hérite
# d'`authenticated` sans l'être lui-même, et il ne contourne pas la RLS. Ne
# mettez JAMAIS un superutilisateur ici : tout l'édifice de politiques
# deviendrait décoratif.
#
# DATABASE_URL_ADMIN ne sert qu'aux tests, pour archiver leurs organisations
# d'essai. Absente, la suite le dit au lieu de laisser croire qu'elle a rangé.
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_ADMIN=
JWT_SECRET=
PORT=
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# L'application web
#
# VITE_API_URL est l'origine de l'API. Elle est exigée en production : sans
# elle, l'application refuse de démarrer plutôt que d'appeler une origine
# devinée.
# ---------------------------------------------------------------------------
VITE_API_URL=

# ---------------------------------------------------------------------------
# Supabase — ce qu'il en reste, et pourquoi
#
# Les données ne passent plus par là : les neuf dépôts métier sont servis par
# l'API, sous la RLS. Il ne subsiste que `capture`, qui dépose des fichiers
# dans le bucket `pieces`, et les deux fonctions serveur qui lisent une pièce
# sous la session de l'utilisateur.
#
# Ces variables disparaîtront avec le stockage, quand il passera sur GCS.
# Aucune clé de service ici : le dépôt n'a plus un seul chemin qui en emprunte.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Le raisonneur — désignation des tokens, jamais de calcul
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# L'œil — relevé du texte et de sa géométrie
#
# QWEN_BASE_URL est l'origine de votre région Model Studio : elle diffère selon
# le site (Singapour, Pékin, Virginie) et une valeur devinée enverrait les
# pièces d'un client au mauvais endroit. Aucune valeur par défaut n'est donc
# fournie par le code.
#
# QWEN_OCR_MODEL est un millésime figé, jamais « -latest » : une mise à jour
# silencieuse changerait le relevé sans qu'une ligne de code ne bouge.
# ---------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_OCR_MODEL=
