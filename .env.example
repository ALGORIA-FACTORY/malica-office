# Copiez ce fichier en .env et renseignez les valeurs.
#
# .env n'est jamais suivi par git — c'est la règle du .gitignore, et le dépôt
# précédent l'avait apprise à ses dépens : il suivait .env, et les clés n'y
# étaient qu'à un « git add -A » de la publication.
#
# Ce fichier ne porte que des NOMS de variables. Jamais une valeur.

# ---------------------------------------------------------------------------
# Base de données et services applicatifs
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Clé de service : contourne la RLS. Elle n'a sa place que sur un chemin
# serveur, jamais dans un bundle client. Elle est aussi ce qui permet à
# tests/smoke/isolation.test.ts de créer ses comptes ; sans elle, cette suite
# s'ignore au lieu d'échouer.
SUPABASE_SERVICE_ROLE_KEY=

# Les mêmes valeurs, exposées au navigateur par Vite. Ne mettez JAMAIS ici une
# variable secrète : tout ce qui porte le préfixe VITE_ part dans le bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Le raisonneur — désignation des tokens, jamais de calcul
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# L'œil — relevé du texte et de sa géométrie
#
# QWEN_BASE_URL est l'origine de votre région Model Studio : elle diffère selon
# le site (Singapour, Pékin, Virginie) et une valeur devinée enverrait les
# pièces d'un client au mauvais endroit. Aucune valeur par défaut n'est donc
# fournie par le code.
#
# QWEN_OCR_MODEL est un millésime figé, jamais « -latest » : une mise à jour
# silencieuse changerait le relevé sans qu'une ligne de code ne bouge.
# ---------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_OCR_MODEL=
