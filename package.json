{
  "name": "regalica-office",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Regalica Office — racine d'espace de travail",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @regalica/web",
    "dev:api": "npm run dev --workspace @regalica/api",
    "build": "npm run build --workspace @regalica/web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && node --test infra/caddy/Caddyfile.test.mjs db/decouper-sql.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:telephone": "node outils/dev-telephone.mjs",
    "certificat": "node outils/certificat-local.mjs",
    "epreuve:bout-en-bout": "node outils/epreuve-bout-en-bout.mjs",
    "verifier": "node outils/verifier.mjs",
    "code-mort": "knip",
    "contrat": "node --experimental-strip-types contrat/relever.mjs --ecrire",
    "coque:staging": "npm run build:coque:staging -w @regalica/web && npm run coque:sync -w @regalica/web",
    "coque:pilote": "npm run build:coque:pilote -w @regalica/web && npm run coque:sync -w @regalica/web",
    "coque:ouvrir": "npm run coque:ouvrir -w @regalica/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "knip": "^6.34.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
