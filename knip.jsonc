// R9 : aucun code mort. knip relève les fichiers, exports et dépendances que
// rien n'atteint. Les points d'entrée sont les scripts qu'on lance à la main
// ou en CI ; ce qui est ignoré l'est pour une raison écrite ici.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "db/**/*.mjs",
        "outils/**/*.mjs",
        "infra/**/*.mjs",
        "android/maestro-diagnostic/*.mjs",
      ],
      // Le certificat de développement se génère avec l'openssl du poste ; le
      // corpus se charge avec le psql du poste (db/corpus/charger-depuis-l-archive.mjs).
      "ignoreBinaries": ["openssl", "psql"],
    },
    "apps/api": {
      "entry": ["src/**/*.test.ts", "tests/real/*.ts"],
    },
    "apps/web": {
      // public/sw.js est servi tel quel et enregistré par son URL
      // (navigator.serviceWorker.register("/sw.js")) : aucun import n'y mène.
      "entry": ["src/routes/**/*.tsx", "scripts/*.mjs", "e2e/**/*.ts", "public/sw.js"],
      // @capacitor/android est le projet Gradle (android/capacitor.settings.gradle
      // le désigne) ; @capacitor/keyboard est un greffon natif enregistré par
      // cap sync et configuré dans capacitor.config.ts, sans import JavaScript.
      // Les trois @fontsource ne sont lus que par les url() de src/polices.css
      // (les fichiers woff2 seuls, avec leur plage de caractères) : knip ne
      // suit pas une url() de feuille de style.
      "ignoreDependencies": [
        "@capacitor/android",
        "@capacitor/keyboard",
        "@fontsource/ibm-plex-mono",
        "@fontsource/inter",
        "@fontsource/noto-kufi-arabic",
      ],
    },
    "packages/socle": {
      "entry": ["src/**/*.ts"],
    },
  },
}
