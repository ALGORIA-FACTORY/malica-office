# Les sauvegardes (profil `sauvegarde`) : dump de la base pg-shared + pièces, chiffrés par restic.
PGHOST=pg-shared
PGUSER=malica
PGDATABASE=malica
PGPASSWORD=
# Un dépôt restic : un dossier local (/restic, volume) ou sftp:u000000@hôte:dossier.
RESTIC_REPOSITORY=/restic
RESTIC_PASSWORD=
SAUVEGARDE_SIGNAL_URL=
