# La base de Malica Office sur le serveur partagé pg-shared (~/pg-shared).
# Lu par scripts/bootstrap-db.sh. Les valeurs sont générées par scripts/init-env.sh.
PG_SHARED_CONTAINER=pg-shared
MALICA_DB_NAME=malica
# Propriétaire de la base : joue les migrations (n'est ni superutilisateur ni CREATEROLE).
MALICA_DB_OWNER=malica
MALICA_DB_OWNER_PASSWORD=
# Rôle de connexion de l'API : membre d'`authenticated`, jamais propriétaire, soumis à la RLS.
MALICA_API_PASSWORD=
