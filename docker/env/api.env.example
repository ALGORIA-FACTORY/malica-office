# L'API. DATABASE_URL emprunte le rôle `malica_api` (RLS) — JAMAIS un superutilisateur.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://malica_api:<MALICA_API_PASSWORD>@pg-shared:5432/malica
# 32 caractères au moins. Le changer déconnecte tout le monde.
JWT_SECRET=
CORS_ORIGINS=http://localhost:8090
STOCKAGE_RACINE=/pieces
JOURNAL_ATTENTE=/journal
CLIENT_MIN_VERSION=
AUTH_ESSAIS_PAR_MINUTE=30
MINIATURES_SIMULTANEES=2
MALICA_VERSION=local
MALICA_URL_PUBLIQUE=http://localhost:8090
# Le second lecteur : vide tant que le profil `ocr` n'est pas lancé.
OCR_URL=
# Les modèles (à renseigner ; sans clé, la lecture et la désignation sont refusées explicitement).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen-vl-ocr-2025-11-20
# Le courriel (invitations, mot de passe oublié). Sans clé, rien ne part.
BREVO_API_KEY=
MALICA_COURRIEL_EXPEDITEUR=no-reply@algoria-factory.com
MALICA_COURRIEL_NOM=Malica Office
