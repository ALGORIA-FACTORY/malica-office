{
  "name": "@malica/sudoku",
  "private": true,
  "type": "module",
  "description": "Le sudoku — lecture prouvée des pièces par les relations de leur grille : moteur Rust, servi en WebAssembly",
  "exports": {
    ".": "./ts/index.ts"
  },
  "scripts": {
    "build": "cargo build --release --target wasm32-unknown-unknown && node ts/copier-le-moteur.mjs",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --release"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "^5.8.3"
  }
}
