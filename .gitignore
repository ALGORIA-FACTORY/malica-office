# Secrets — jamais suivis. Le dépôt précédent suivait .env : les clés
# n'étaient qu'un « git add -A » de la publication.
.env
.env.*
!.env.example

# Dépendances et sorties de build
node_modules/
dist/
dist-ssr/
.output/
.nitro/
.tanstack/
.vinxi/
*.local

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# Journaux
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environnements de développement
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Systèmes de fichiers
.DS_Store
Thumbs.db
desktop.ini

# Les pièces déposées en local : des documents de clients, jamais dans git.
.stockage/

# Sauvegardes de la base locale : des dumps, reconstructibles, jamais dans git.
db/sauvegardes/

# Le certificat de développement : propre à chaque machine, jamais partagé.
.certificats/

# Les PDF telecharges par le corpus et le texte qu'on en tire : un cache, pas
# une source. Il se refait avec db/corpus/reconstruire.mjs et notes.mjs.
db/corpus/pdf/
db/corpus/pdf-nc/
journal-atelier.log
