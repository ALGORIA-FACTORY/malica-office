# Malica Office — les variables d'un environnement (staging, pilote, production).
#
#   cp env.exemple /srv/malica/.env && chmod 600 /srv/malica/.env
#
# Un secret se génère, ne s'invente pas :   openssl rand -base64 48
# Ce fichier ne quitte jamais le serveur ; sa copie chiffrée vit dans le coffre.

# L'origine publique. Caddy y obtient son certificat Let's Encrypt : le DNS
# doit pointer sur la machine AVANT le premier démarrage.
DOMAINE=staging.malica-office.algoria-factory.com
# Un second nom servi le temps d'une bascule (l'ancien reste joignable), sinon vide.
DOMAINE_ALIAS=

# D'où viennent les images : le registre GHCR du dépôt, en minuscules.
REGISTRE=ghcr.io/wbarouni

# La version servie. Écrite par deployer.sh à chaque déploiement.
VERSION=main

# La base. Le superutilisateur ne sert qu'aux migrations et aux sauvegardes ;
# l'API n'a que son rôle, sous RLS. Le second se pose sur le rôle par
# `migrer --mot-de-passe-api` à chaque déploiement : le changer ici suffit.
POSTGRES_PASSWORD=
MALICA_API_PASSWORD=

# Signe les jetons de session (12 h) et de rafraîchissement — 32 caractères
# au moins. Le changer déconnecte tout le monde : jamais un jour d'échéance.
JWT_SECRET=

# La version la plus ancienne de la coque encore servie (X-Malica-Client).
# Vide : toutes. « 0.3.0 » : les coques plus anciennes voient « mettez à jour ».
CLIENT_MIN_VERSION=

# Tentatives de connexion par minute et par adresse, avant le 429.
AUTH_ESSAIS_PAR_MINUTE=30

# Les modèles — des clés de l'API seulement, le serveur web n'en voit aucune.
# L'hôte Model Studio dépend de la région du compte (Singapour ci-dessous).
DEEPSEEK_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen-vl-ocr-2025-11-20

# Où vivent les données sur le disque (le Volume, hors du disque système).
PIECES_DIR=/srv/malica/pieces
POSTGRES_DIR=/srv/malica/postgres
RESTAURATION_DIR=/srv/malica/restauration

# Les sauvegardes hors site : un dépôt restic sur la Storage Box, par SFTP
# (port 23), avec la clé ci-dessous — chemin RELATIF au dossier de la box, un
# chemin absolu y est refusé. RESTIC_PASSWORD chiffre le dépôt :
# perdu, les sauvegardes sont illisibles — il vit aussi dans le coffre.
RESTIC_REPOSITORY=sftp:u000000@u000000.your-storagebox.de:malica
RESTIC_PASSWORD=
RESTIC_CLE_SSH=/srv/malica/sauvegarde/cle_ssh

# Le signal de vie des sauvegardes (moniteur « push » d'Uptime Kuma) : appelé
# après chaque sauvegarde réussie ; la surveillance alerte sur le silence.
SAUVEGARDE_SIGNAL_URL=
