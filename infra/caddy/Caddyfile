# Une origine publique par environnement.
#
# Les chemins de l'API sont ceux de `apps/web/relais-api.ts`, à l'identique —
# `Caddyfile.test.mjs` échoue s'ils divergent. Le relais de développement a
# déjà tranché : page et API sur la même origine, donc plus de CORS ni de
# domaine de cookie. `/auth` tout seul est l'écran de connexion de
# l'application ; ses sous-chemins sont l'API.

# DOMAINE_ALIAS : un second nom (le temps d'une bascule de domaine), vide sinon.
{$DOMAINE} {$DOMAINE_ALIAS} {
	encode zstd gzip

	# Vingt-quatre pages en PDF tiennent bien en dessous ; l'API coupe elle
	# aussi à quarante mégaoctets.
	request_body {
		max_size 40MB
	}

	@api {
		path /rpc /rpc/* /moi /moi/* /sante /sante/* /pieces /pieces/*
		path /journal-atelier /journal-atelier/* /malica/* /auth/* /exports/*
		path /impressions /impressions/*
	}

	# Une lecture par Malica peut durer des minutes.
	handle @api {
		reverse_proxy api:3000 {
			transport http {
				response_header_timeout 300s
			}
		}
	}

	handle {
		reverse_proxy web:8080
	}

	# Campagne du 21 octobre 2026 (ANO-027) : ni X-Frame-Options ni CSP. La
	# politique ci-dessous ne touche pas aux scripts (le rendu serveur en pose
	# en ligne) : elle interdit d'encadrer l'application, d'y changer la base
	# des liens, d'y charger un objet, et d'envoyer un formulaire ailleurs.
	#
	# `?` : la politique n'est qu'un défaut. Les octets d'une pièce ou d'un
	# export portent la leur, posée par l'API (`sandbox; default-src 'none'`,
	# audit du 6 novembre 2026, S1) ; ce bloc est différé (il retire `Server`)
	# et, sans `?`, il l'écraserait.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		?Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server
	}

	log {
		output file /data/acces.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
